# Docker image. The default reuses the already-built LISA CUDA 12.1 image.
ANNOTATION_BASE_IMAGE=lisa-safety-seg:lisa13b-clean030-v1-records-20260723
ANNOTATION_IMAGE=lisa-annotation:groundingdino-v1
ANNOTATION_SOURCE_COMMIT=unknown

# Direct API exposure; no reverse proxy is required.
ANNOTATION_BIND_ADDRESS=0.0.0.0
ANNOTATION_API_PORT=8008
ANNOTATION_API_KEY=replace-with-a-long-random-secret
ANNOTATION_CORS_ORIGINS=http://frontend.example.internal
ANNOTATION_DOCS_ENABLED=true
ANNOTATION_CONTAINER_UID=1000
ANNOTATION_CONTAINER_GID=1000

# Host paths are deployment-specific and must not be committed with real values.
ANNOTATION_STORAGE_HOST_PATH=/replace/with/persistent/annotation-data
GROUNDING_DINO_SOURCE_HOST_PATH=/replace/with/GroundingDINO
GROUNDING_DINO_MODEL_HOST_PATH=/replace/with/MODEL_STORE/groundingdino/swint-ogc/upstream-v1
ANNOTATION_SAM_MODEL_HOST_PATH=/replace/with/MODEL_STORE/sam/vit-h/upstream-4b8939-v1

# Free-form detection queue and GroundingDINO settings.
ANNOTATION_MAX_QUEUED_JOBS=100
ANNOTATION_CUDA_VISIBLE_DEVICES=0
ANNOTATION_GROUNDING_DINO_MODEL_VERSION=groundingdino-swint-ogc
ANNOTATION_GROUNDING_DINO_PROMPT_VERSION=free-form-v1
# Prompt normalization plug-in for A/B comparison.
ANNOTATION_GROUNDING_DINO_PROMPT_NORMALIZATION_MODE=terminal_period
ANNOTATION_GROUNDING_DINO_PROMPT_NORMALIZATION_PROFILE=construction_safety_v1
ANNOTATION_GROUNDING_DINO_PROMPT_TRANSLATION_FAILURE_POLICY=fallback_canonical_terms
# Reachable OpenAI-compatible endpoint from inside the worker container.
ANNOTATION_PROMPT_TRANSLATOR_BASE_URL=http://replace-with-qwen-host:18000/qwen25/v1
ANNOTATION_PROMPT_TRANSLATOR_CONTAINER_BASE_URL=http://host.docker.internal:18000/qwen25/v1
ANNOTATION_PROMPT_TRANSLATOR_MODEL=qwen25vl
ANNOTATION_PROMPT_TRANSLATOR_API_KEY=
ANNOTATION_PROMPT_TRANSLATOR_TIMEOUT_SECONDS=30
ANNOTATION_PROMPT_TRANSLATOR_MAX_TOKENS=300
ANNOTATION_PROMPT_TRANSLATOR_TEMPERATURE=0
ANNOTATION_PROMPT_TRANSLATOR_PROMPT_VERSION=open-semantic-zh-en-v1
ANNOTATION_GROUNDING_DINO_BOX_THRESHOLD=0.35
ANNOTATION_GROUNDING_DINO_TEXT_THRESHOLD=0.25
ANNOTATION_WORKER_ID=grounding-dino-docker-1
ANNOTATION_WORKER_LEASE_SECONDS=300
ANNOTATION_WORKER_HEARTBEAT_SECONDS=60
ANNOTATION_WORKER_POLL_SECONDS=0.2
