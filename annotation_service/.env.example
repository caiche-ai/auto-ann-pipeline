# API identity
ANNOTATION_SERVICE_VERSION=1.5.1

# Leave empty only for local contract testing. For a real deployment, generate
# a secret in the untracked .env, for example: openssl rand -hex 32
ANNOTATION_API_KEY=

# Comma-separated browser frontend origins, without trailing slash. This does
# not control server-to-server requests from Spring.
ANNOTATION_CORS_ORIGINS=http://localhost:3000
ANNOTATION_CORS_ALLOW_CREDENTIALS=false

# HTTP and image limits. The request limit must exceed the image limit because
# multipart requests include headers and metadata.
ANNOTATION_MAX_REQUEST_BYTES=31457280
ANNOTATION_MAX_IMAGE_BYTES=20971520
ANNOTATION_MAX_IMAGE_PIXELS=25000000
ANNOTATION_MAX_METADATA_CHARS=16384

# Maximum jobs waiting for a GPU Worker. Idempotent retries do not consume
# additional queue capacity.
ANNOTATION_MAX_QUEUED_JOBS=100

# Expose /docs, /redoc, and /openapi.json.
ANNOTATION_DOCS_ENABLED=true

# SQLite metadata and controlled image/artifact storage. Replace this with an
# absolute persistent directory outside the source tree in deployment. API and
# every Worker must use exactly the same directory.
ANNOTATION_STORAGE_ENABLED=true
ANNOTATION_STORAGE_ROOT=/replace/with/persistent/annotation-data

# GroundingDINO GPU Worker. ROOT is the pinned source checkout containing the
# groundingdino Python package. Config, checkpoint, and offline BERT belong to
# one MODEL_STORE artifact and may be absolute paths outside ROOT.
ANNOTATION_GROUNDING_DINO_ROOT=/replace/with/GroundingDINO
ANNOTATION_GROUNDING_DINO_CONFIG=/replace/with/MODEL_STORE/groundingdino/swint-ogc/upstream-v1/GroundingDINO_SwinT_OGC.py
ANNOTATION_GROUNDING_DINO_CHECKPOINT=/replace/with/MODEL_STORE/groundingdino/swint-ogc/upstream-v1/groundingdino_swint_ogc.pth
ANNOTATION_GROUNDING_DINO_BERT=/replace/with/MODEL_STORE/groundingdino/swint-ogc/upstream-v1/text_encoder/bert-base-uncased
ANNOTATION_GROUNDING_DINO_DEVICE=cuda
ANNOTATION_GROUNDING_DINO_MODEL_VERSION=groundingdino-swint-ogc
# Provenance version for verbatim user-supplied GroundingDINO prompts.
ANNOTATION_GROUNDING_DINO_PROMPT_VERSION=free-form-v1
# Prompt normalization plug-in for A/B comparison:
# off | terminal_period | canonical_terms | llm_grounding_caption
ANNOTATION_GROUNDING_DINO_PROMPT_NORMALIZATION_MODE=terminal_period
# construction_safety_v1 | open_semantic_zh_en_v1
ANNOTATION_GROUNDING_DINO_PROMPT_NORMALIZATION_PROFILE=construction_safety_v1
# fail_job | fallback_canonical_terms | fallback_terminal_period
ANNOTATION_GROUNDING_DINO_PROMPT_TRANSLATION_FAILURE_POLICY=fallback_canonical_terms
# Open-semantic text translator. BASE_URL/MODEL/API_KEY fall back to the Qwen
# values below when omitted.
ANNOTATION_PROMPT_TRANSLATOR_BASE_URL=http://127.0.0.1:18000/qwen25/v1
ANNOTATION_PROMPT_TRANSLATOR_MODEL=qwen25vl
ANNOTATION_PROMPT_TRANSLATOR_API_KEY=
ANNOTATION_PROMPT_TRANSLATOR_TIMEOUT_SECONDS=30
ANNOTATION_PROMPT_TRANSLATOR_MAX_TOKENS=300
ANNOTATION_PROMPT_TRANSLATOR_TEMPERATURE=0
ANNOTATION_PROMPT_TRANSLATOR_PROMPT_VERSION=open-semantic-zh-en-v1
ANNOTATION_GROUNDING_DINO_BOX_THRESHOLD=0.35
ANNOTATION_GROUNDING_DINO_TEXT_THRESHOLD=0.25

# Free-form GroundingDINO Worker queue lease. Heartbeat must be shorter than
# lease.
ANNOTATION_WORKER_ID=grounding-dino-worker-1
ANNOTATION_WORKER_LEASE_SECONDS=300
ANNOTATION_WORKER_HEARTBEAT_SECONDS=60
ANNOTATION_WORKER_POLL_SECONDS=0.2

# SAM box-prompt Worker. The checkpoint belongs in MODEL_STORE; the Python
# package comes from the pinned application/source environment.
ANNOTATION_SAM_CHECKPOINT=/replace/with/MODEL_STORE/sam/vit-h/upstream-4b8939-v1/sam_vit_h_4b8939.pth
ANNOTATION_SAM_MODEL_TYPE=vit_h
ANNOTATION_SAM_DEVICE=cuda
ANNOTATION_SAM_PYTHON_PACKAGE=model.segment_anything
ANNOTATION_SAM_MODEL_VERSION=sam-vit-h-4b8939
ANNOTATION_SAM_POLYGON_EPSILON=1.0
# Maximum queued boxes from the same image processed after one set_image().
ANNOTATION_SAM_MAX_BATCH_SIZE=16
# Number of recent image embeddings kept in GPU memory for repeated box edits.
ANNOTATION_SAM_IMAGE_CACHE_SIZE=2
ANNOTATION_SAM_WORKER_ID=sam-worker-1
ANNOTATION_SAM_LEASE_SECONDS=300
ANNOTATION_SAM_HEARTBEAT_SECONDS=60
ANNOTATION_SAM_POLL_SECONDS=0.2

# Qwen2.5-VL Prompt Worker. This points to an OpenAI-compatible /v1 endpoint.
# The API and the other Workers can start before this model service is ready.
ANNOTATION_QWEN_BASE_URL=http://127.0.0.1:18000/qwen25/v1
ANNOTATION_QWEN_MODEL=qwen25vl
ANNOTATION_QWEN_API_KEY=
ANNOTATION_QWEN_TIMEOUT_SECONDS=120
ANNOTATION_QWEN_MAX_TOKENS=1200
ANNOTATION_QWEN_FACTS_TEMPERATURE=0.1
ANNOTATION_QWEN_PROMPTS_TEMPERATURE=0.3
ANNOTATION_QWEN_WORKER_ID=qwen25vl-worker-1
ANNOTATION_QWEN_LEASE_SECONDS=300
ANNOTATION_QWEN_HEARTBEAT_SECONDS=60
ANNOTATION_QWEN_POLL_SECONDS=0.2

# Model-free ReasonSeg release Worker.
ANNOTATION_RELEASE_WORKER_ID=release-worker-1
ANNOTATION_RELEASE_LEASE_SECONDS=300
ANNOTATION_RELEASE_HEARTBEAT_SECONDS=60
ANNOTATION_RELEASE_POLL_SECONDS=2

# Select the physical GPU before starting any host Python Worker. Within the
# process, ANNOTATION_*_DEVICE=cuda then refers to visible device 0.
CUDA_VISIBLE_DEVICES=0

# GroundingDINO always uses the offline BERT artifact configured above.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
