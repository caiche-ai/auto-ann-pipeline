# Runtime secrets and local configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python environments and caches
.venv/
venv/
__pycache__/
*__pycache__*
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Persistent service data and backups
data/
data.backup*/
logs/
run/
annotation_service.backup*/

# Developer-facing annotation review workspace
/review_workspace/outputs/*
!/review_workspace/outputs/.gitkeep
/review_workspace/exports/*
!/review_workspace/exports/.gitkeep

# Developer-facing pipeline debug workspace
/debug/sessions/*
!/debug/sessions/.gitkeep

# External source checkouts and generated artifacts
# SAM's pinned Python source is tracked under third_party/segment_anything.
# GroundingDINO remains a deployment-local checkout because it is a complete
# upstream project with its own build products.
/third_party/GroundingDINO/
*.db
*.db-*
*.log
*.pid
*.tar
*.tar.gz
*.zip
*.pt
*.pth
*.ckpt
*.safetensors

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# React frontend dependencies and generated output
/frontend/node_modules/
/frontend/dist/
/frontend/.run/
/frontend/*.tsbuildinfo
/frontend/vite.config.js
/frontend/vite.config.d.ts
